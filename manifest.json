{
  "manifest_version": 3,
  "name": "Dokkan News Tracker",
  "version": "1.5",
  "description": "Follow Dokkan news and customize scan times",
  "permissions": ["alarms", "storage", "notifications"],
  "host_permissions": ["https://dokkaninfo.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}